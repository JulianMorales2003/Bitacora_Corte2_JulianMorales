# Copie este archivo como ".env" y complete los valores. El archivo .env NO se sube a Git.
#
# JWT_SECRET: clave HMAC en Base64 de minimo 256 bits (32 bytes). Para generarla:
#   Linux/Mac/Git Bash:  openssl rand -base64 48
#   PowerShell:          [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
JWT_SECRET=

# Clave de PostgreSQL (opcional; si se omite se usa "brasaviva" solo para desarrollo local)
DB_PASSWORD=

# Clave de los usuarios de ejemplo (opcional; por defecto Brasa2026)
SEED_PASSWORD=

# Solo para HTTPS (perfil "ssl"): clave del keystore PKCS12
SSL_KEYSTORE_PASSWORD=